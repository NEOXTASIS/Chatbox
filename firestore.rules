rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower() == 'neoxtasis666@gmail.com';
    }

    function isApproved() {
      return signedIn()
        && (
          isOwner()
          || (
            request.auth.token.email != null
            && exists(/databases/$(database)/documents/allowed/$(request.auth.token.email.lower()))
          )
        );
    }

    function inRoom(roomId) {
      return signedIn() && request.auth.uid in roomId.split('_');
    }

    match /allowed/{email} {
      allow get: if isOwner()
        || (signedIn()
          && request.auth.token.email != null
          && request.auth.token.email.lower() == email);
      allow list, create, update, delete: if isOwner();
    }

    match /pendingSignups/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['uid', 'email', 'status', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.auth.token.email != null
        && request.resource.data.email is string
        && request.resource.data.email == request.auth.token.email.lower()
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is timestamp;

      allow get: if isOwner()
        || (signedIn() && request.auth.uid == userId);
      allow list: if isOwner();
      allow update, delete: if isOwner();
    }

    match /messages/{messageId} {
      allow read: if isApproved();
      allow create: if isApproved()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.t is number;
      allow update, delete: if false;
    }

    match /dms/{roomId}/messages/{messageId} {
      function validRoomAccess() {
        return isApproved()
          && inRoom(roomId)
          && roomId.split('_').size() == 2;
      }

      allow read: if validRoomAccess();

      allow create: if validRoomAccess()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.t is number;

      // Permit only the sender to edit message text and its edit timestamp.
      // All other fields, including sender identity and attachments, remain immutable.
      allow update: if validRoomAccess()
        && (
          (
            resource.data.uid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt'])
            && request.resource.data.diff(resource.data).affectedKeys().hasAll(['text', 'editedAt'])
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 2000
            && request.resource.data.editedAt is number
          )
          ||
          (
            resource.data.uid != request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
            && request.resource.data.readBy is list
            && request.resource.data.readBy.size() <= 2
            && request.resource.data.readBy.hasOnly(roomId.split('_'))
            && (!('readBy' in resource.data) || request.resource.data.readBy.hasAll(resource.data.readBy))
            && request.auth.uid in request.resource.data.readBy
          )
        );

      allow delete: if validRoomAccess()
        && resource.data.uid == request.auth.uid;

      match /reactions/{reactionId} {
        function canAccessMessage() {
          return validRoomAccess()
            && exists(/databases/$(database)/documents/dms/$(roomId)/messages/$(messageId));
        }

        allow read: if canAccessMessage();

        allow create: if canAccessMessage()
          && request.resource.data.keys().hasOnly(['uid', 'emoji', 't'])
          && request.resource.data.keys().hasAll(['uid', 'emoji', 't'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.emoji is string
          && request.resource.data.emoji.size() > 0
          && request.resource.data.emoji.size() <= 16
          && request.resource.data.t is number
          && reactionId == request.auth.uid + '_' + request.resource.data.emoji;

        allow update: if false;

        allow delete: if canAccessMessage()
          && resource.data.uid == request.auth.uid
          && reactionId == request.auth.uid + '_' + resource.data.emoji;
      }
    }

    match /profiles/{userId} {
      allow read: if isApproved();
      allow create, update: if isApproved()
        && (request.auth.uid == userId || isOwner())
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 20
        && request.resource.data.avatar is string
        && request.resource.data.avatar.size() < 100000;
      allow delete: if isOwner();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}